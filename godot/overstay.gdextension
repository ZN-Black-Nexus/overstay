[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../rust/target/debug/liboverstay.so"
linux.release.x86_64 = "res://../rust/target/release/liboverstay.so"
windows.debug.x86_64 = "res://../rust/target/debug/overstay.dll"
windows.release.x86_64 = "res://../rust/target/release/overstay.dll"
macos.debug = "res://../rust/target/debug/liboverstay.dylib"
macos.release = "res://../rust/target/release/liboverstay.dylib"
macos.debug.arm64 = "res://../rust/target/debug/liboverstay.dylib"
macos.release.arm64 = "res://../rust/target/release/liboverstay.dylib"
